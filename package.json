{
  "name": "highlight-boost",
  "version": "0.1.0",
  "private": true,
  "description": "Semantic highlighting for prose and code blocks in Obsidian.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare:vault": "node scripts/prepare-vault.mjs",
    "test:host": "pnpm build && pnpm prepare:vault && node scripts/test-host.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@electron/remote": "2.1.3",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "electron": "38.8.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  }
}
